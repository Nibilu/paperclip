[Unit]
Description=Pilibala Tailscale HTTPS broker
After=tailscaled.service
Requires=tailscaled.service

[Service]
Type=simple
User=pilibala-tsbroker
Group=pilibala-tsbroker-sock
EnvironmentFile=/etc/pilibala/tailscale-https-broker.env
ExecStart=/usr/bin/node /opt/pilibala/packages/tailscale-https-broker/dist/main.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=pilibala-tailscale-broker
RuntimeDirectoryMode=0750
StateDirectory=pilibala-tailscale-broker
StateDirectoryMode=0700
LogsDirectory=pilibala-tailscale-broker
LogsDirectoryMode=0700
ReadWritePaths=/run/pilibala-tailscale-broker /var/lib/pilibala-tailscale-broker /var/log/pilibala-tailscale-broker

[Install]
WantedBy=multi-user.target
