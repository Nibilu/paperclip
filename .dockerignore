.git
.github
.pilibala
.pnpm-store
node_modules
**/node_modules
coverage
data
tmp
*.log
packages/pilibala-runner/dist
packages/pilibala-runner/runner/target
packages/pilibala-runner/devtools
packages/pilibala-runner/docs
packages/pilibala-runner/examples
packages/pilibala-runner/test
packages/pilibala-runner/test-fixtures
packages/pilibala-runner/test-support
packages/pilibala-runner/**/*.md
packages/pilibala-runner/**/*.spec.ts
packages/pilibala-runner/**/*.spec.tsx
packages/pilibala-runner/**/*.test.cjs
packages/pilibala-runner/**/*.test.cts
packages/pilibala-runner/**/*.test.js
packages/pilibala-runner/**/*.test.jsx
packages/pilibala-runner/**/*.test.mjs
packages/pilibala-runner/**/*.test.mts
packages/pilibala-runner/**/*.test.ts
packages/pilibala-runner/**/*.test.tsx
packages/pilibala-runner/runner/crates/*/tests
packages/pilibala-runner/scripts/*-smoke.mjs
# Exceptions (last match wins): the image build re-runs the runner's
# generated-file drift checks, so their committed outputs and inputs must
# survive the slimming above. 2026-09-04: the *.md rule stripped the
# committed capability contract out of the context and every image build
# on master failed its drift check — .github/docker-context-checks.Dockerfile
# now guards this in PR CI.
!packages/pilibala-runner/generated/**
# ACPX generation verifies these immutable release attestations as build inputs.
# Keep current declarations and historical identities while excluding other development fixtures.
!packages/pilibala-runner/test
packages/pilibala-runner/test/**
!packages/pilibala-runner/test/fixtures
packages/pilibala-runner/test/fixtures/**
!packages/pilibala-runner/test/fixtures/copilot-profile-v16-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v17-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v18-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v18-muse-historical-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v19-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v19-muse-historical-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v20-identity.json
!packages/pilibala-runner/test/fixtures/copilot-profile-v21-identity.json
!packages/pilibala-runner/test-fixtures
packages/pilibala-runner/test-fixtures/**
!packages/pilibala-runner/test-fixtures/pi-acp
packages/pilibala-runner/test-fixtures/pi-acp/**
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v18-identity.json
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v19-identity.json
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v20-identity.json
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v21-identity.json
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v22-identity.json
!packages/pilibala-runner/test-fixtures/pi-acp/profile-v23-identity.json
!packages/pilibala-runner/docs/capability-contract.md
# check:runner-workflow-traceability access()es every regression test the
# stress-traceability spec names — those are src/**/*.test.ts files, so
# they must survive the *.test.ts rule above.
!packages/pilibala-runner/src/**/*.test.ts
!packages/pilibala-runner/src/**/*.test.tsx

packages/grok-acp/bin
