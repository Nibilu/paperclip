# Local development only
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=https://clip.nibilu.in
PAPERCLIP_ALLOWED_HOSTNAMES=192.168.31.16,localhost,127.0.0.1,clip.nibilu.in
PAPERCLIP_INSECURE_AUTH_HTTP_HOSTS=192.168.31.16
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.31.16:3104,http://localhost:3104,http://127.0.0.1:3104,https://clip.nibilu.in
# Serve built UI bundle from ui/dist: dev-middleware Vite HMR client (serverPort+10000) cannot reach the tunnel through 443
PAPERCLIP_UI_DEV_MIDDLEWARE=false
